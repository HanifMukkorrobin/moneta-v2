# ============================================================================
# Moneta v2 Backend - Environment Configuration (backend/.env.example)
# ============================================================================

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

DB_PATH=./data/moneta.sqlite
DB_WAL_MODE=true

NINEROUTER_API_URL=https://api.9router.com/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=google/gemini-2.0-flash
NINEROUTER_TIPS_MODEL=google/gemini-2.0-flash
AI_REQUEST_TIMEOUT_MS=8000

SESSION_TTL_DAYS=30

DEFAULT_CURRENCY=IDR
DEFAULT_CURRENCY_SYMBOL=Rp
DEFAULT_MONTHLY_BUDGET_LIMIT=6000000
DEFAULT_TARGET_DAILY_SPEND=65000
DEFAULT_BUDGET_ALERT_THRESHOLD=80
DEFAULT_NEEDS_PCT=50
DEFAULT_SAVINGS_PCT=30
DEFAULT_FUN_PCT=20

ENABLE_REMINDER_SCHEDULER=true
REMINDER_SCHEDULER_INTERVAL_MS=60000
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_MORNING_REMINDER_TIME=08:00
DEFAULT_EVENING_REMINDER_TIME=20:00
ANALYSIS_CACHE_TTL_HOURS=24
DAILY_ADVICE_CACHE_TTL_HOURS=24
